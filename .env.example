# =============================================================================
# Rastro Público - Exemplo de variáveis de ambiente
# Copie para `.env` e ajuste conforme o ambiente.
# NUNCA versione o arquivo `.env` real nem credenciais.
# =============================================================================

# --- Aplicação ---
APP_NAME="Rastro Público"
ENVIRONMENT=development            # development | test | production
DEBUG=true
LOG_LEVEL=INFO

# --- Banco de dados (PostgreSQL) ---
POSTGRES_USER=rastro
POSTGRES_PASSWORD=rastro
POSTGRES_DB=rastro_publico
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rastro:rastro@localhost:5432/rastro_publico

# --- Redis (usado apenas para cache/rate-limit e tarefas assíncronas) ---
REDIS_URL=redis://localhost:6379/0
ENABLE_CELERY=false

# --- Segurança ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:3000

# --- Conectores de dados públicos ---
# O PNCP é público e não exige autenticação para consulta.
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
PNCP_PAGE_SIZE=50
PNCP_TIMEOUT_SECONDS=30
PNCP_MAX_RETRIES=4
# Portal da Transparência exige chave gratuita (https://api.portaldatransparencia.gov.br)
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
# Câmara dos Deputados (dados abertos, sem autenticação)
CAMARA_BASE_URL=https://dadosabertos.camara.leg.br/api/v2

# --- IA (opcional) ---
# A plataforma funciona sem provedor de IA. Valores possíveis: disabled | openai | local
AI_PROVIDER=disabled
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_MAX_OUTPUT_TOKENS=1200

# --- Armazenamento de documentos (S3-compatível, opcional) ---
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=rastro-documentos
S3_REGION=us-east-1

# --- Frontend (usado no build do Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
